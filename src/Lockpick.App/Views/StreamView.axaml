<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lockpick.App.ViewModels"
             xmlns:c="using:Lockpick.App.Controls"
             x:Class="Lockpick.App.Views.StreamView"
             x:DataType="vm:StreamViewModel">

  <ScrollViewer c:SectionScroll.Section="{Binding SelectedSection}">
    <Panel>
    <StackPanel Spacing="12" IsVisible="{Binding SelectedSection, Converter={x:Static c:SectionIs.Instance}, ConverterParameter=widgets}">

      <Border Classes="card">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="cardhead">
              <c:LucideIcon Data="{StaticResource Icon.PanelsTopLeft}" />
              <TextBlock Classes="caption" Text="STREAM" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding EditText}" Command="{Binding ToggleEditingCommand}"
                    AutomationProperties.Name="Customize the Stream page" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                     Text="The overlay's widgets here, as big as you like, so the game's picture can stay clean (turn the overlay's widgets off in Settings). Customize picks the widgets, their order and sizes. Pop a widget out to put it on another monitor or capture it in OBS (Window Capture; right-click the window for a green background)." />
          <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding Editing}">
            <ComboBox ItemsSource="{Binding Addable}" SelectedItem="{Binding ToAdd}" MinWidth="240"
                      AutomationProperties.Name="A widget to add" />
            <Button Content="Add" Command="{Binding AddCommand}" />
            <Button Content="Default layout" Command="{Binding ResetLayoutCommand}" />
          </WrapPanel>
          <TextBlock IsVisible="{Binding !HasTiles}" Foreground="{StaticResource LpMutedBrush}"
                     Text="No widgets on the page: Customize to add some." />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="12" LineSpacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StreamTile">
            <Border Classes="card" Width="{Binding Width}" Height="{Binding Height}" Padding="10" VerticalAlignment="Top">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caption" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Editing}">
                      <Button Content="◀" Command="{Binding EarlierCommand}" ToolTip.Tip="Earlier" AutomationProperties.Name="Move earlier" />
                      <Button Content="▶" Command="{Binding LaterCommand}" ToolTip.Tip="Later" AutomationProperties.Name="Move later" />
                      <Button Content="{Binding SizeText}" Command="{Binding BiggerCommand}" ToolTip.Tip="Size: small, medium or large"
                              AutomationProperties.Name="Change the size" />
                      <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Take it off the page" AutomationProperties.Name="Remove" />
                    </StackPanel>
                    <Button Content="{Binding PopOutText}" Command="{Binding PopOutCommand}" ToolTip.Tip="Show this widget in a window of its own" />
                  </StackPanel>
                </Grid>
                <c:WidgetView Grid.Row="1" Margin="0,8,0,0" WidgetId="{Binding Id}" EmptyBrush="{StaticResource LpMutedBrush}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

    <!-- OBS: each widget as a Browser Source, and Lockpick's OBS script -->
    <StackPanel Spacing="12" IsVisible="{Binding SelectedSection, Converter={x:Static c:SectionIs.Instance}, ConverterParameter=obs}">
    <!-- The stream layout: the ticked widgets in one Browser Source -->
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" Text="ONE BROWSER SOURCE FOR EVERYTHING" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                   Text="Tick the widgets your stream should show and choose where each sits and how large. One OBS Browser Source shows them all, transparent; what you change here shows in OBS within a second. Widgets in the same place are stacked." />
        <ItemsControl ItemsSource="{Binding LayoutRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamLayoutRow">
              <Grid ColumnDefinitions="300,Auto,Auto" ColumnSpacing="10" Margin="0,2">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding Shown}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in the browser source'}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:StreamLayoutRow.CornerChoices}" SelectedItem="{Binding Corner}" MinWidth="140"
                          IsEnabled="{Binding Shown}" AutomationProperties.Name="{Binding Name, StringFormat='Where {0} sits'}" />
                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:StreamLayoutRow.SizeChoices}" SelectedItem="{Binding Size}" MinWidth="86"
                          IsEnabled="{Binding Shown}" AutomationProperties.Name="{Binding Name, StringFormat='Size of {0}'}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding LayoutUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Button Content="Copy OBS link" Click="OnCopyObsLink" Tag="{Binding LayoutUrl}" Classes="accent"
                  AutomationProperties.Name="Copy the OBS link for the one browser source" />
          <TextBlock Text="In OBS: Sources → + → Browser, paste it, and set the width and height to your canvas (e.g. 1920 × 1080)."
                     TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource LpMutedBrush}" />
        </WrapPanel>
        <TextBlock Text="{Binding ObsNote}" TextWrapping="Wrap" IsVisible="{Binding LayoutUrl, Converter={x:Static ObjectConverters.IsNull}}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" Text="OBS BROWSER SOURCES" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                   Text="Each widget as its own OBS source, transparent and live — the same as on the overlay, so you can place them anywhere on your stream. (A pop-out window with Window Capture works too.)" />
        <TextBlock Text="{Binding ObsNote}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding ObsLinks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ObsLinkRow">
              <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="10" Margin="0,3">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource LpMutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Copy OBS link" Click="OnCopyObsLink" Tag="{Binding Url}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Copy the OBS link for {0}'}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Copied" Foreground="{StaticResource LpGreenBrush}" IsVisible="False" Text="Copied. Paste it into an OBS Browser Source." />
      </StackPanel>
    </Border>

    <!-- Lockpick's OBS script -->
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" Text="OBS SCRIPT" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                   Text="Lockpick's script for OBS adds these sources (and a Game Capture of the game) with one button, and can record each run, put chapter markers at splits, deaths and fails, save the replay buffer on a death, a fail or a new best, and switch to a &quot;paused&quot; scene while the game isn't in front. Every part is optional." />
        <TextBlock TextWrapping="Wrap" Text="In OBS: Tools → Scripts → + → choose this file:" />
        <SelectableTextBlock Classes="mono" Text="{Binding ObsScript}" TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <Button Content="Show the script" Click="OnShowScript" />
          <Button Content="Copy its path" Click="OnCopyObsLink" Tag="{Binding ObsScript}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Lockpick's own connection to OBS (its WebSocket server, #65) -->
    <Border Classes="card" DataContext="{Binding Obs}">
      <StackPanel Spacing="8" x:DataType="vm:ObsLinkViewModel">
        <TextBlock Classes="caption" Text="OBS WEBSOCKET (OPTIONAL)" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                   Text="The script's automation from Lockpick's side, through OBS's WebSocket server: for OBS on another PC (a streaming PC), or without installing the script. While Lockpick is connected to OBS on this PC, the script leaves these to Lockpick (its hotkeys keep working), so nothing happens twice. In OBS: Tools → WebSocket Server Settings → Enable WebSocket server." />
        <CheckBox Content="Connect to OBS" IsChecked="{Binding Enabled}" AutomationProperties.Name="Connect to OBS's WebSocket server" />
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <TextBlock Classes="label" Text="OBS on" VerticalAlignment="Center" />
          <TextBox Text="{Binding Host}" Watermark="127.0.0.1 (this PC)" MinWidth="200" AutomationProperties.Name="The PC OBS runs on" />
          <TextBlock Classes="label" Text="Port" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" MinWidth="130"
                         AutomationProperties.Name="OBS WebSocket port" />
          <Button Content="Connect" Command="{Binding ConnectCommand}" />
        </WrapPanel>
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <TextBox Text="{Binding PasswordInput}" PasswordChar="•" Watermark="OBS's WebSocket password" MinWidth="260"
                   AutomationProperties.Name="OBS WebSocket password" />
          <Button Content="Save password" Command="{Binding SavePasswordCommand}" Classes="accent" />
          <Button Content="Remove password" Command="{Binding RemovePasswordCommand}" IsVisible="{Binding HasPassword}" />
          <Button Content="Fill in from OBS on this PC" Command="{Binding FillFromObsCommand}"
                  ToolTip.Tip="Reads the port and password from OBS's own settings on this PC" />
        </WrapPanel>
        <TextBlock Text="{Binding PasswordStatus}" TextWrapping="Wrap"
                   IsVisible="{Binding PasswordStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes.warning="{Binding Problem}" />
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Classes="warning"
                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="label" Text="What Lockpick does in OBS" Margin="0,6,0,0" />
        <CheckBox Content="Record each run (start with the run, stop when it ends)" IsChecked="{Binding RecordWithRuns}" />
        <WrapPanel ItemSpacing="8" LineSpacing="6" IsEnabled="{Binding RecordWithRuns}">
          <TextBlock Text="Keep recording after a run ends (seconds)" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding StopDelay}" Minimum="0" Maximum="120" Increment="1" FormatString="0" MinWidth="110"
                         AutomationProperties.Name="Seconds to keep recording after a run" />
        </WrapPanel>
        <CheckBox Content="Chapter markers at splits, deaths and fails (Hybrid MP4, OBS 30.2+)" IsChecked="{Binding Chapters}" />
        <CheckBox Content="Save the replay buffer on a death" IsChecked="{Binding ReplayOnDeath}" />
        <CheckBox Content="Save the replay buffer when a challenge fails" IsChecked="{Binding ReplayOnFail}" />
        <CheckBox Content="Save the replay buffer on a new personal best" IsChecked="{Binding ReplayOnBest}" />
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <CheckBox Content="Switch scene while the game isn't in front:" IsChecked="{Binding PauseSceneEnabled}" />
          <ComboBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding PauseScene}" MinWidth="200" IsEnabled="{Binding PauseSceneEnabled}"
                    AutomationProperties.Name="The paused scene" />
        </WrapPanel>

        <TextBlock Classes="label" Text="Lockpick scene" Margin="0,6,0,0" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource LpMutedBrush}"
                   Text="Makes a &quot;Lockpick&quot; scene in OBS with the widgets as browser sources and, for OBS on this PC, a Game Capture of the game. Sources already there keep where you put them. Needs Lockpick's API on (and, for OBS on another PC, allowed on your network)." />
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <Button Content="Set up OBS" Command="{Binding SetUpSceneCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding SetUpResult}" TextWrapping="Wrap"
                   IsVisible="{Binding SetUpResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
